@inject IBodyLifeRequestContextResolver RequestContextResolver
@inject Microsoft.Extensions.Localization.IStringLocalizer<Shared> SharedLocalizer

@if (RequestContextResolver.TryResolve(out var requestContext))
{
    var actor = requestContext.Actor;
    var displayName = User.Identity?.Name ?? AccountTypeLabel(actor.AccountKind);
    var deviceLabel = actor.DeviceLabel ?? SharedLocalizer["Session.DeviceUnavailable"];
    var sessionId = actor.SessionId.Value.ToString("N")[..8];
    <details class="account-menu" data-account-menu>
        <summary aria-label="@SharedLocalizer["Session.Current"]">
            <span class="account-menu-avatar" aria-hidden="true">@Initials(displayName)</span>
            <span class="account-menu-summary-copy">
                <strong>@displayName</strong>
                <span>@CompactAccountTypeLabel(actor.AccountKind)</span>
            </span>
            <span class="account-menu-marker" aria-hidden="true">⌄</span>
        </summary>
        <div class="account-menu-popover">
            <div class="account-menu-identity">
                <strong>@displayName</strong>
                <span>@AccountTypeLabel(actor.AccountKind) / @RoleLabel(actor.Role)</span>
            </div>
            <div class="account-menu-session" aria-label="@SharedLocalizer["Session.CurrentAccountAndDevice"]">
                <span><partial name="_Icon" model='@("device")' /> @deviceLabel</span>
                <span class="session-id">@SharedLocalizer["Session.Identifier", sessionId]</span>
            </div>
            <partial name="_LanguageSelector" />
            <form class="logout-form" asp-page="/Logout" method="post">
                <button type="submit"><partial name="_Icon" model='@("logout")' /><span>@SharedLocalizer["Navigation.Logout"]</span></button>
            </form>
        </div>
    </details>
}

@functions {
    private string AccountTypeLabel(AccountKind accountKind) => accountKind switch
    {
        AccountKind.Owner => SharedLocalizer["AccountKind.Owner"],
        AccountKind.NamedAdmin => SharedLocalizer["AccountKind.NamedAdmin"],
        AccountKind.SharedReceptionAdmin => SharedLocalizer["AccountKind.SharedReceptionAdmin"],
        _ => SharedLocalizer["AccountKind.Unknown"],
    };

    private string RoleLabel(ActorRole role) => role switch
    {
        ActorRole.Owner => SharedLocalizer["Role.Owner"],
        ActorRole.Admin => SharedLocalizer["Role.Admin"],
        _ => SharedLocalizer["Role.Unknown"],
    };

    private string CompactAccountTypeLabel(AccountKind accountKind) => accountKind switch
    {
        AccountKind.Owner => SharedLocalizer["AccountKind.OwnerCompact"],
        AccountKind.NamedAdmin => SharedLocalizer["AccountKind.NamedAdminCompact"],
        AccountKind.SharedReceptionAdmin => SharedLocalizer["AccountKind.SharedReceptionAdminCompact"],
        _ => SharedLocalizer["AccountKind.UnknownCompact"],
    };

    private static string Initials(string name) => string.Concat(name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
}
