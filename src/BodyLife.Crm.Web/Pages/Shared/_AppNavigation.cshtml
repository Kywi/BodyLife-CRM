@inject IBodyLifeRequestContextResolver RequestContextResolver
@inject Microsoft.Extensions.Localization.IStringLocalizer<Shared> SharedLocalizer
@{
    RequestContextResolver.TryResolve(out var requestContext);
    var actor = requestContext?.Actor;
    var path = Context.Request.Path;
    var isOwner = actor is { Role: ActorRole.Owner, AccountKind: AccountKind.Owner };
    var reportsActive = path.StartsWithSegments("/Reports");
    var dailyReportActive = path.StartsWithSegments("/Reports/Daily");
    var homeActive = path == "/";
    var receptionActive = path.StartsWithSegments("/Reception");
    var historyActive = path.StartsWithSegments("/Audit/ClientHistory");
    var auditActive = path.StartsWithSegments("/Audit/Timeline");
    var membershipTypesActive = path.StartsWithSegments("/Owner/MembershipTypes");
    var nonWorkingDaysActive = path.StartsWithSegments("/Owner/NonWorkingDays");
    var staffAccountsActive = path.StartsWithSegments("/Owner/StaffAccounts");
}
<aside class="app-sidebar" aria-label="@SharedLocalizer["Navigation.Label"]">
    <a class="sidebar-brand" asp-page="/Index">
        <img src="~/images/bodylife-logo.png" width="338" height="480" alt="@SharedLocalizer["Brand.LogoAlt"]" />
        <span>BodyLife CRM</span>
    </a>

    <nav class="sidebar-navigation" aria-label="@SharedLocalizer["Navigation.Label"]">
        <section class="navigation-group" aria-labelledby="navigation-main">
            <h2 id="navigation-main">@SharedLocalizer["Navigation.Main"]</h2>
            <a class="navigation-link @(homeActive ? "is-active" : null)" asp-page="/Index" aria-current="@(homeActive ? "page" : null)">
                <partial name="_Icon" model='@("home")' /><span>@SharedLocalizer["Navigation.Home"]</span>
            </a>
            <a class="navigation-link @(receptionActive ? "is-active" : null)" asp-page="/Reception/Index" aria-current="@(receptionActive ? "page" : null)">
                <partial name="_Icon" model='@("reception")' /><span>@SharedLocalizer["Navigation.Clients"]</span>
            </a>
            <a class="navigation-link @(dailyReportActive ? "is-active" : reportsActive ? "is-section-active" : null)" asp-page="/Reports/Daily" aria-current="@(dailyReportActive ? "page" : reportsActive ? "location" : null)">
                <partial name="_Icon" model='@("reports")' /><span>@SharedLocalizer["Navigation.Reports"]</span>
            </a>
            <a class="navigation-link @(auditActive ? "is-active" : historyActive ? "is-section-active" : null)" asp-page="/Audit/Timeline" aria-current="@(auditActive ? "page" : historyActive ? "location" : null)">
                <partial name="_Icon" model='@("audit")' /><span>@SharedLocalizer["Navigation.History"]</span>
            </a>
        </section>

        @if (isOwner)
        {
            <details class="owner-tools" aria-labelledby="navigation-owner" @(membershipTypesActive || nonWorkingDaysActive || staffAccountsActive ? "open" : null)>
                <summary id="navigation-owner"
                         aria-label="@SharedLocalizer["Navigation.OwnerTools"]"
                         title="@SharedLocalizer["Navigation.OwnerTools"]">
                    <partial name="_Icon" model='@("users")' />
                    <span>@SharedLocalizer["Navigation.More"]</span>
                </summary>
                <div class="owner-tools-links">
                <a class="navigation-link @(membershipTypesActive ? "is-active" : null)" asp-page="/Owner/MembershipTypes" aria-current="@(membershipTypesActive ? "page" : null)">
                    <partial name="_Icon" model='@("membership")' /><span>@SharedLocalizer["Navigation.MembershipTypes"]</span>
                </a>
                <a class="navigation-link @(nonWorkingDaysActive ? "is-active" : null)" asp-page="/Owner/NonWorkingDays" aria-current="@(nonWorkingDaysActive ? "page" : null)">
                    <partial name="_Icon" model='@("calendar")' /><span>@SharedLocalizer["Navigation.NonWorkingDays"]</span>
                </a>
                <a class="navigation-link @(staffAccountsActive ? "is-active" : null)" asp-page="/Owner/StaffAccounts" aria-current="@(staffAccountsActive ? "page" : null)">
                    <partial name="_Icon" model='@("users")' /><span>@SharedLocalizer["Navigation.StaffAccounts"]</span>
                </a>
                </div>
            </details>
        }
    </nav>

    <div class="sidebar-footer">
        <partial name="_LanguageSelector" />
        <form class="logout-form" asp-page="/Logout" method="post">
            <button class="navigation-link navigation-logout" type="submit"><partial name="_Icon" model='@("logout")' /><span>@SharedLocalizer["Navigation.Logout"]</span></button>
        </form>
    </div>
</aside>
