@inject IBodyLifeRequestContextResolver RequestContextResolver
@inject Microsoft.Extensions.Localization.IStringLocalizer<Shared> SharedLocalizer
@{
    RequestContextResolver.TryResolve(out var requestContext);
    var actor = requestContext?.Actor;
    var path = Context.Request.Path;
    var isOwner = actor is { Role: ActorRole.Owner, AccountKind: AccountKind.Owner };
    var reportsActive = path.StartsWithSegments("/Reports");
    var dailyReportActive = path.StartsWithSegments("/Reports/Daily");
    var homeActive = path == "/";
    var receptionActive = path.StartsWithSegments("/Reception");
    var historyActive = path.StartsWithSegments("/Audit/ClientHistory");
    var auditActive = path.StartsWithSegments("/Audit/Timeline");
    var membershipTypesActive = path.StartsWithSegments("/Owner/MembershipTypes");
    var nonWorkingDaysActive = path.StartsWithSegments("/Owner/NonWorkingDays");
    var staffAccountsActive = path.StartsWithSegments("/Owner/StaffAccounts");
}
<aside id="app-navigation-drawer" class="app-sidebar app-navigation-drawer" data-app-drawer aria-label="@SharedLocalizer["Navigation.Label"]">
    <div class="drawer-heading">
        <span>@SharedLocalizer["Navigation.Label"]</span>
        <button type="button" data-drawer-close aria-label="@SharedLocalizer["Navigation.CloseMenu"]">×</button>
    </div>
    <nav class="sidebar-navigation" aria-label="@SharedLocalizer["Navigation.Label"]">
        <section class="navigation-group" data-nav-group="operations" aria-labelledby="navigation-operations">
            <h2 id="navigation-operations">@SharedLocalizer["Navigation.Operations"]</h2>
            <a class="navigation-link @(homeActive ? "is-active" : null)" asp-page="/Index" aria-label="@SharedLocalizer["Navigation.Home"]" aria-current="@(homeActive ? "page" : null)">
                <partial name="_Icon" model='@("home")' /><span>@SharedLocalizer["Navigation.Home"]</span>
            </a>
            <a class="navigation-link @(receptionActive ? "is-active" : null)" asp-page="/Reception/Index" aria-label="@SharedLocalizer["Navigation.Clients"]" aria-current="@(receptionActive ? "page" : null)">
                <partial name="_Icon" model='@("reception")' /><span>@SharedLocalizer["Navigation.Clients"]</span>
            </a>
        </section>
        <section class="navigation-group" data-nav-group="records" aria-labelledby="navigation-records">
            <h2 id="navigation-records">@SharedLocalizer["Navigation.RecordsHistory"]</h2>
            <a class="navigation-link @(dailyReportActive ? "is-active" : reportsActive ? "is-section-active" : null)" asp-page="/Reports/Daily" aria-label="@SharedLocalizer["Navigation.Reports"]" aria-current="@(dailyReportActive ? "page" : reportsActive ? "location" : null)">
                <partial name="_Icon" model='@("reports")' /><span>@SharedLocalizer["Navigation.Reports"]</span>
            </a>
            <a class="navigation-link @(auditActive ? "is-active" : historyActive ? "is-section-active" : null)" asp-page="/Audit/Timeline" aria-label="@SharedLocalizer["Navigation.History"]" aria-current="@(auditActive ? "page" : historyActive ? "location" : null)">
                <partial name="_Icon" model='@("audit")' /><span>@SharedLocalizer["Navigation.History"]</span>
            </a>
        </section>

        @if (isOwner)
        {
            <section class="navigation-group owner-tools" data-nav-group="owner" aria-labelledby="navigation-owner">
                <h2 id="navigation-owner">@SharedLocalizer["Navigation.OwnerTools"]</h2>
                <a class="navigation-link @(membershipTypesActive ? "is-active" : null)" asp-page="/Owner/MembershipTypes" aria-label="@SharedLocalizer["Navigation.MembershipTypes"]" aria-current="@(membershipTypesActive ? "page" : null)">
                    <partial name="_Icon" model='@("membership")' /><span>@SharedLocalizer["Navigation.MembershipTypes"]</span>
                </a>
                <a class="navigation-link @(nonWorkingDaysActive ? "is-active" : null)" asp-page="/Owner/NonWorkingDays" aria-label="@SharedLocalizer["Navigation.NonWorkingDays"]" aria-current="@(nonWorkingDaysActive ? "page" : null)">
                    <partial name="_Icon" model='@("calendar")' /><span>@SharedLocalizer["Navigation.NonWorkingDays"]</span>
                </a>
                <a class="navigation-link @(staffAccountsActive ? "is-active" : null)" asp-page="/Owner/StaffAccounts" aria-label="@SharedLocalizer["Navigation.StaffAccounts"]" aria-current="@(staffAccountsActive ? "page" : null)">
                    <partial name="_Icon" model='@("users")' /><span>@SharedLocalizer["Navigation.StaffAccounts"]</span>
                </a>
            </section>
        }
    </nav>

</aside>
